<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen background — solid green with centred logo text.
    Used by Theme.KutiraKone.Splash in themes.xml.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background fill — brand green -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3B6D11" />
        </shape>
    </item>

    <!-- Centred app icon placeholder -->
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

</layer-list>